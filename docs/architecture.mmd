%% Source for docs/architecture.svg. Edit this file, then re-render the image:
%%
%%   npx -y @mermaid-js/mermaid-cli@11.4.2 -i docs/architecture.mmd -o docs/architecture.svg -b white
%%
%% What the picture is for: showing that no job holds a permission of its own.
%% Every arrow out of GitHub lands on a hub, and a hub can do exactly one
%% thing — become one spoke in one project. Change the hub and you change who
%% may act; change the spoke and you change what that act may touch.
flowchart LR
  subgraph GH["GitHub Actions"]
    direction TB
    PR["pull request<br/>live-plan.yml"]
    CD["push to dev<br/>stg-cd.yml · org-cd.yml"]
    DP["medusa-backend<br/>deploy-stg.yml"]
  end

  subgraph MGMT["protech-medusa-mgmt"]
    direction TB
    POOL["identity pool<br/>github-plan · github-apply"]
    HUBS["hubs, one right each<br/>plan · apply · tunnel-token · deploy"]
    CFSA["Cloudflare plan and apply<br/>service accounts"]
    MSTATE[("management state<br/>org · _setup · cloudflare")]
  end

  subgraph ENV["protech-medusa-stg — prd is identical"]
    direction TB
    SPOKES["spokes<br/>plan read-only · apply · token writer · deploy"]
    ESTATE[("environment state")]
    VM["API VM<br/>application + cloudflared"]
    AR["Artifact Registry"]
    SM["Secret Manager<br/>tunnel token"]
    MON["uptime check on /health<br/>CPU · memory · disk alerts"]
  end

  subgraph CFL["Cloudflare"]
    direction TB
    TOK["plan token · master token"]
    ZONE["zone<br/>DNS record · settings"]
    TUN["tunnel"]
  end

  PR -->|"OIDC, no key"| POOL
  CD --> POOL
  DP --> POOL
  POOL --> HUBS
  HUBS -->|"impersonate"| SPOKES
  SPOKES --> ESTATE
  SPOKES --> VM
  SPOKES --> AR
  SPOKES --> SM
  SPOKES --> MON
  CD --> CFSA
  CFSA --> MSTATE
  CFSA --> TOK
  TOK --> ZONE
  VM -->|"pull image"| AR
  VM -->|"read token"| SM
  VM -->|"outbound only"| TUN
  TUN --> ZONE
  MON -->|"https /health"| ZONE
