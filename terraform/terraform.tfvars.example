# Copy to terraform.tfvars and fill in your own values — terraform.tfvars is
# gitignored. Keep real account and project identifiers out of this file: it is
# committed, and in a public repository it would hand a reader your exact
# targets. Credentials belong in environment variables, never here:
#
#   export TF_VAR_cloudflare_api_token='…'
#   export TF_VAR_github_token="$(gh auth token)"

gcp_project_id = "<your-gcp-project-id>"
gcp_region     = "us-central1" # free-tier e2-micro: us-central1 / us-west1 / us-east1
gcp_zone       = "us-central1-a"

cloudflare_account_id = "<your-cloudflare-account-id>"
cloudflare_zone_id    = "<your-cloudflare-zone-id>"
cloudflare_api_token  = "<cf-token>" # prefer TF_VAR_cloudflare_api_token

github_owner = "<your-org-or-user>"
github_token = "<gh-pat>" # prefer TF_VAR_github_token

# Keep this to ONE subdomain level. Cloudflare's Universal SSL covers the apex
# and *.<domain> only — a deeper host has no edge certificate on the Free plan.
domain      = "<your-domain>"
environment = "stg"
service     = "medusa-backend"

machine_type      = "e2-micro"
boot_disk_size_gb = 10
