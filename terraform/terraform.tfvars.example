# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
# Prefer environment variables in CI: TF_VAR_cloudflare_api_token, etc.

gcp_project_id = "project-78c2f5ca-96f0-47c0-ad0"
gcp_region     = "us-central1"
gcp_zone       = "us-central1-a"

cloudflare_account_id = "d97012cc36b813ffedff1fe0a81323e0"
cloudflare_zone_id    = "56c2da224b281f29c803d2542dfe6c71"
cloudflare_api_token  = "<cf-token>"   # export TF_VAR_cloudflare_api_token instead

github_owner = "fahlula"
github_token = "<gh-pat-with-repo-scope>"  # export TF_VAR_github_token instead

domain      = "fabianalula.site"
environment = "stg"
service     = "medusa-backend"

machine_type      = "e2-micro"
boot_disk_size_gb = 10
